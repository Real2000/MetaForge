# ================================================================
#  智能体开发平台 · 环境变量说明模板
#  本文件供参考，不参与运行。复制为 .env 后再修改。
# ================================================================

# ---- 服务端口 ----
# 平台 HTTP 监听端口（默认 3210）
# PORT=3210

# ---- 数据目录 ----
# 生产库、加密密钥、向量库等文件所在目录；默认在项目根的 data/ 目录
# AGENT_DATA_DIR=./data

# ---- OCR 服务地址 ----
# 扫描版 PDF 的 PaddleOCR 识别服务 URL（可选，不配置时功能不受影响，扫描版 PDF 解析较粗略）
# PADDLEOCR_URL=http://127.0.0.1:9300

# ---- License 公钥覆盖（仅签发机轮换时使用） ----
# 生产部署不应设置该变量；仅在签发机生成新密钥对时临时设为新公钥 hex 用于验证
# LICENSE_PUBKEY_HEX=

# ---- 日志级别 ----
# 控制台输出级别：debug / info / warn / error
# LOG_LEVEL=info

# ---- 定时任务与运维轮转 ----
# 每日备份保留份数（默认 30）
# BACKUP_RETENTION=30
# 产物（用户文件）保留天数（默认 30）
# ARTIFACT_RETENTION_DAYS=30
# 日志保留天数（默认 90）
# LOG_RETENTION_DAYS=90

# ---- 开发/调试 ----
# # 允许内网元数据地址请求（仅调试用，生产不设置）
# AGENT_FETCH_ALLOW_PRIVATE=1
