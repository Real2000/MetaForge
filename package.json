{
  "name": "agent-platform",
  "version": "1.0.0",
  "description": "企业级智能体平台：前台（首页对话/智能体/知识库/任务管理）+ 管理后台（数据看板/智能体管理/知识库管理/接入管理/模型接入/安全合规/系统监控/运营监控）",
  "keywords": [
    "agent",
    "llm",
    "ai-platform",
    "mcp",
    "rag",
    "knowledge-base",
    "workflow",
    "self-hosted",
    "express",
    "sqlite"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Real2000/MetaForge.git"
  },
  "bugs": {
    "url": "https://github.com/Real2000/MetaForge/issues"
  },
  "homepage": "https://github.com/Real2000/MetaForge#readme",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "reset": "node scripts/reset.js",
    "test": "node test/smoke.js && node test/tenant-e2e.js",
    "test:smoke": "node test/smoke.js",
    "test:tenant": "node test/tenant-e2e.js",
    "lint:sql": "node scripts/lint-bare-prepare.js",
    "lint:sql:update": "node scripts/lint-bare-prepare.js --update",
    "lint:schema": "node scripts/lint-inline-schema.js",
    "lint:schema:update": "node scripts/lint-inline-schema.js --update-baseline",
    "migrate": "node scripts/migrate.js",
    "dialect:audit": "node scripts/dialect-audit.js",
    "package": "node scripts/package.js",
    "package:version": "node scripts/package.js --version",
    "deploy:check": "node scripts/deploy-check.js",
    "deploy:linux": "npm rebuild better-sqlite3 --update-binary && node scripts/deploy-check.js",
    "build:sdk": "sh scripts/build-sdk.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "docx": "^9.13.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "mammoth": "^1.13.0",
    "msedge-tts": "^2.1.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "autocannon": "^9.0.0",
    "commander": "^15.1.0"
  },
  "optionalDependencies": {
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1"
  }
}
